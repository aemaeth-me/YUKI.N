cabal-version: 3.0
name:          yuki-n
version:       0.1.0.0
synopsis:      资讯统合思念体对有机生命体接触用人形界面
description:   资讯统合思念体对有机生命体接触用人形界面
homepage:      https://github.com/aemaeth-me/YUKI.N
bug-reports:   https://github.com/aemaeth-me/YUKI.N/issues
license:       BSD-3-Clause
license-file:  LICENSE
author:        YUKI.N contributors
category:      AI
build-type:    Simple
extra-doc-files:
    README.md
extra-source-files:
    .hlint.yaml
    AGENTS.md
    fourmolu.yaml
    hie.yaml
    docs/README.md
    docs/cognition-design.md
    docs/haskell-architecture.md
    docs/memory/*.md
    frontend/test/backend-control-e2e.mjs
    frontend/web/control.js
    scripts/check-test-docs.py
    scripts/test_check_test_docs.py
    test/golden/*.jsonl

source-repository head
    type:     git
    location: https://github.com/aemaeth-me/YUKI.N.git

common options
    default-extensions:
        LambdaCase
        OverloadedStrings
    default-language: GHC2024
    ghc-options:      -Wall -Wcompat
    build-depends:    base >=4.20 && <5

library
    import:         options
    exposed-modules:
        Yuki.N
        Yuki.N.Agent
        Yuki.N.AGUI.Event
        Yuki.N.AGUI.Types
        Yuki.N.AgentsMd
        Yuki.N.Anatomy
        Yuki.N.Artifact
        Yuki.N.AtomicFile
        Yuki.N.Background
        Yuki.N.Blob
        Yuki.N.Config
        Yuki.N.Cognition
        Yuki.N.Context
        Yuki.N.ContextEpoch
        Yuki.N.Diff
        Yuki.N.Domain.Diff
        Yuki.N.Experience
        Yuki.N.Facts
        Yuki.N.Inspect
        Yuki.N.Incarnation
        Yuki.N.Invocation
        Yuki.N.Journal
        Yuki.N.Memory
        Yuki.N.Memory.Archive
        Yuki.N.Memory.Impression
        Yuki.N.Memory.LongTerm
        Yuki.N.Memory.Working
        Yuki.N.Model
        Yuki.N.Provider.OpenAI
        Yuki.N.Providers
        Yuki.N.Replay
        Yuki.N.Runs
        Yuki.N.Server
        Yuki.N.Sessions
        Yuki.N.SubAgent
        Yuki.N.ThreadConfig
        Yuki.N.Tools
        Yuki.N.Transcript
    hs-source-dirs: src
    build-depends:
        aeson >=2.2 && <2.3,
        async >=2.2 && <2.3,
        bytestring >=0.12 && <0.13,
        containers >=0.7 && <0.8,
        directory >=1.3 && <1.4,
        http-client >=0.7 && <0.8,
        http-client-tls >=0.3 && <0.4,
        http-types >=0.12 && <0.13,
        filepath >=1.4 && <1.6,
        process >=1.6 && <1.7,
        text >=2.1 && <2.2,
        time >=1.12 && <1.13,
        wai >=3.2 && <3.3,
        warp >=3.4 && <3.5

executable yuki-n
    import:         options
    main-is:        Main.hs
    hs-source-dirs: app
    ghc-options:     -threaded -rtsopts -with-rtsopts=-N
    build-depends:  text, yuki-n

test-suite yuki-n-test
    import:         options
    type:           exitcode-stdio-1.0
    main-is:        Main.hs
    other-modules:  E2E,
        Golden,
        Yuki.N.AGUITest,
        Yuki.N.AdversarialTest,
        Yuki.N.AgentTest,
        Yuki.N.AgentsMdTest,
        Yuki.N.AnatomyTest,
        Yuki.N.ArtifactTest,
        Yuki.N.Cognition.ArchiveTest,
        Yuki.N.Cognition.LifecycleTest,
        Yuki.N.Cognition.MemoryTest,
        Yuki.N.Cognition.SleepTest,
        Yuki.N.CognitionTest,
        Yuki.N.ConfigTest,
        Yuki.N.ContextTest,
        Yuki.N.DiffTest,
        Yuki.N.FactsTest,
        Yuki.N.GrowthTest,
        Yuki.N.InvocationTest,
        Yuki.N.JournalTest,
        Yuki.N.MemoryTest,
        Yuki.N.Provider.OpenAITest,
        Yuki.N.ProvidersTest,
        Yuki.N.RunsTest,
        Yuki.N.ServerTest,
        Yuki.N.ServerCognitionTest,
        Yuki.N.SessionTest,
        Yuki.N.SubAgentTest,
        Yuki.N.TestSupport,
        Yuki.N.ThreadConfigTest,
        Yuki.N.ToolsTest,
        Yuki.N.TranscriptTest
    hs-source-dirs: test
    ghc-options:    -threaded -Werror
    build-depends:
        aeson >=2.2 && <2.3,
        bytestring >=0.12 && <0.13,
        containers >=0.7 && <0.8,
        directory >=1.3 && <1.4,
        filepath >=1.4 && <1.6,
        http-client >=0.7 && <0.8,
        http-client-tls >=0.3 && <0.4,
        http-types >=0.12 && <0.13,
        process >=1.6 && <1.7,
        QuickCheck >=2.14 && <3,
        tasty >=1.5 && <1.6,
        tasty-hunit >=0.10 && <0.11,
        tasty-quickcheck >=0.10 && <0.11,
        text >=2.1 && <2.2,
        wai >=3.2 && <3.3,
        wai-extra >=3.1 && <3.2,
        warp >=3.4 && <3.5,
        yuki-n
